# Only VITE_-prefixed vars reach the browser bundle.

# false: in-browser encryption + verdict from src/fixtures/captured-verdict.json.
# true:  also trigger the live deployed workflow and show the returned verdict.
VITE_LIVE_MODE=false

# Enclave X25519 public key. Must match config.staging.json enclavePublicKey.
VITE_ENCLAVE_PUBLIC_KEY=0x375128744ecd24947690752d5fc2f80b48133372874dd28b16afbd5e610ff90b

# Demo request prefilled into the submit form (target + calldata).
VITE_DEMO_TARGET=0x0000000000000000000000000000000000000000
VITE_DEMO_NETWORK=eth-sepolia
VITE_DEMO_TOKEN=native
VITE_DEMO_CALLDATA=0x9e5faafc

# Same-origin path the browser POSTs the ciphertext to (proxied to CRE).
VITE_TRIGGER_URL=/api/trigger

# Bearer token for a self-hosted pre-auth endpoint only. Ships to the client.
VITE_TRIGGER_AUTH=

# Optional result endpoint to poll for the verdict: GET <url>?executionId=<id>.
VITE_RESULT_URL=

# Server-side only (read by the dev proxy, never shipped). Required for live mode.
CRE_GATEWAY_URL=
CRE_WORKFLOW_ID=
CRE_SIGNER_PRIVATE_KEY=
