{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "types": ["node", "mocha", "chai"],
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["hardhat.config.ts", "test/**/*.ts", "ignition/**/*.ts", "scripts/**/*.ts"]
}
