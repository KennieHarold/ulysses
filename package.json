{
	"name": "exploit-verifier-ui",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"description": "Live demo UI for the Chainlink CRE confidential exploit-verifier workflow: encrypt an exploit in the browser, trigger the enclave, show only the Verdict.",
	"packageManager": "pnpm@10.33.0",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"dependencies": {
		"react": "^19.1.0",
		"react-dom": "^19.1.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@noble/ciphers": "2.4.0",
		"@noble/curves": "1.9.6",
		"@noble/hashes": "2.2.0",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.3.0",
		"@types/node": "^22.13.0",
		"@types/react": "^19.1.0",
		"@types/react-dom": "^19.1.0",
		"@vitejs/plugin-react": "^4.4.1",
		"eslint": "^9.39.5",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.26",
		"globals": "^15.15.0",
		"jsdom": "^26.0.0",
		"prettier": "^3.9.6",
		"typescript": "5.9.3",
		"typescript-eslint": "^8.70.0",
		"viem": "2.34.0",
		"vite": "^6.3.5",
		"vitest": "^3.1.4"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	}
}
