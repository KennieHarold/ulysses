{
  "name": "ulysses",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:shared": "pnpm --filter @ulysses/shared build",
    "dev": "pnpm build:shared && pnpm --filter \"./apps/*\" --parallel dev",
    "build": "pnpm build:shared && pnpm --filter \"./apps/*\" --parallel build",
    "typecheck": "pnpm build:shared && pnpm -r --parallel typecheck",
    "check:secrets": "bash scripts/check-secrets.sh"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
